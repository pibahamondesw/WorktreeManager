{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for WorktreeManager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "store:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "obsidian:*" }]
    },
    "dialog:default",
    "shell:allow-open",
    "shell:allow-execute",
    "updater:default",
    "process:allow-restart"
  ]
}
