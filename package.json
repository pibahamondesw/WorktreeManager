{
  "name": "worktreemanager",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "repository": {
    "type": "git",
    "url": "https://github.com/pibahamondesw/WorktreeManager.git"
  },
  "homepage": "https://github.com/pibahamondesw/WorktreeManager",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$HOME/.cache/worktreemanager-target} tauri",
    "tauri:dev:shared": "WTM_DEV_SIGNING_IDENTITY=\"${WTM_DEV_SIGNING_IDENTITY:-WorktreeManager Development}\" pnpm run tauri dev",
    "tauri:dev:local": "CARGO_TARGET_DIR=$HOME/.cache/worktreemanager-target tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:snapshot": "sh scripts/seed-dev-snapshot.sh env WTM_DEV_SIGNING_IDENTITY=\"${WTM_DEV_SIGNING_IDENTITY:-WorktreeManager Development}\" pnpm run tauri dev --config src-tauri/tauri.snapshot.conf.json",
    "lint": "pnpm run lint:ts && pnpm run lint:rust",
    "lint:ts": "eslint src scripts *.config.ts eslint.config.js",
    "lint:rust": "cd src-tauri && CARGO_TARGET_DIR=$HOME/.cache/worktreemanager-target cargo clippy --all-targets && cargo fmt --all -- --check",
    "lint:fix": "pnpm run lint:ts:fix && pnpm run lint:rust:fix",
    "lint:ts:fix": "eslint src scripts *.config.ts eslint.config.js --fix",
    "lint:rust:fix": "cd src-tauri && CARGO_TARGET_DIR=$HOME/.cache/worktreemanager-target cargo clippy --all-targets --fix --allow-dirty --allow-staged && cargo fmt --all",
    "typecheck": "tsc -b",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,json,md,html}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage src/services/store.test.ts src/utils.test.ts src/services/operations.test.ts",
    "test:watch": "vitest",
    "release": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@linear/sdk": "^75.0.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-testing-library": "^7.16.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "knip": "6.40.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
}
